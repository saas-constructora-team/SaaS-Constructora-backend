# Copia este archivo como .env y completa los valores reales.
# .env está ignorado por git: nunca subas credenciales al repositorio.
#
# IMPORTANTE: las variables de entorno del sistema (o las definidas en la
# configuración de ejecución del IDE) TIENEN PRIORIDAD sobre este archivo.
# Si el arranque muestra "[EMAIL] Proveedor activo=resend" pero aquí pusiste
# EMAIL_PROVIDER=smtp, revisa el entorno del IDE / la shell antes de culpar al .env.

# Base de datos PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/saas_constructora
DB_USERNAME=saas
DB_PASSWORD=

# ---------------------------------------------------------------------------
# CORREO (HU-13): elige UN proveedor con EMAIL_PROVIDER
# ---------------------------------------------------------------------------
# resend = API de Resend (por defecto si la variable no existe)
# smtp   = SMTP clásico (Gmail, etc.)
EMAIL_PROVIDER=resend

# --- Opción Resend (EMAIL_PROVIDER=resend) ---
# Obtén la key en https://resend.com/api-keys
# RESEND_FROM DEBE ser un correo de un dominio verificado en Resend, por
# ejemplo onboarding@resend.dev para pruebas. Un valor sin "@" como
# "saasconstructora.correounivalle.edu.co" NO es válido y el envío fallará.
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev

# --- Opción SMTP (EMAIL_PROVIDER=smtp) ---
# Para Gmail: activa la verificación en 2 pasos y crea una "Contraseña de aplicación"
# (no uses la contraseña normal de la cuenta).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# Base del frontend para el enlace de recuperación
APP_BASE_URL=http://localhost:4200

# Google OAuth (HU-01). Obtén el client-id en Google Cloud Console →
# API y servicios → Credenciales → ID de cliente de OAuth (tipo Web).
GOOGLE_CLIENT_ID=

# Clave RSA PKCS#8 en Base64 para firmar JWTs. Genera una con:
# openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 | openssl pkcs8 -topk8 -nocrypt -outform DER | base64 -w0
# Configúrala en despliegues para conservar la validez de los tokens entre reinicios.
# Si queda vacía, se genera una clave temporal para desarrollo local.
JWT_PRIVATE_KEY=
JWT_TTL_MINUTES=60
